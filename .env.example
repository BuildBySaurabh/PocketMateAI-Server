# Copy to .env and fill in. Never commit .env (it is in .gitignore).

# EASIEST: paste any supported key here and leave AI_PROVIDER blank. The service is detected from the key:
#   sk-ant-...  Anthropic        sk-... / sk-proj-...  OpenAI      AIza...  Google Gemini
#   gsk_...     Groq             sk-or-...             OpenRouter
# Any other service with an OpenAI-style API: also set AI_BASE_URL (for example https://api.example.com/v1) and AI_MODEL.
# The key stays on this server; it is never put in the app.
AI_API_KEY=
# Optional: choose a different model than the default for your service (model names change over time).
AI_MODEL=
AI_BASE_URL=

# Leave blank for the above. "mock" needs no key and gives canned replies. "anthropic" uses ANTHROPIC_API_KEY below.
AI_PROVIDER=

# Required when AI_PROVIDER=anthropic. This key stays on the server, never in the app.
ANTHROPIC_API_KEY=
# Check the current model name in Anthropic's docs and change it here if needed.
ANTHROPIC_MODEL=claude-sonnet-5-5

# The app sends this as "Authorization: Bearer <token>". Must be 16+ characters; the server refuses to
# start with a short or placeholder value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=

# Requests allowed per minute per client.
RATE_LIMIT_PER_MINUTE=20

# Optional web search. The app only uses it when the user switches "Web search" on, and then the
# question text is sent to the search service. Leave blank to disable.
SEARCH_PROVIDER=none
SEARCH_API_KEY=
